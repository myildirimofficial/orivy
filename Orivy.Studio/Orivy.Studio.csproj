<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orivy\Orivy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parses re-imported Designer code (see CodeImporter) using real C# syntax analysis instead of
         a fragile hand-rolled regex/text scanner. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
